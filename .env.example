# === Dashboard ===
DASHBOARD_PORT=3000
# WAJIB diset. Gunakan string acak yang kuat (mis. `openssl rand -base64 48`).
# Aplikasi akan menolak start jika ini tidak diset.
JWT_SECRET=ganti-dengan-secret-key-yang-aman

# Password awal untuk akun admin dashboard yang dibuat otomatis saat first run.
# Jika tidak diset, password acak akan digenerate dan dicetak SEKALI ke console
# saat aplikasi pertama kali start — segera ganti lewat menu Pengaturan.
ADMIN_PASSWORD=

# Daftar origin (comma-separated) yang boleh mengakses API dashboard secara
# cross-origin, mis: https://dashboard.example.com,https://app.example.com
# Kosongkan jika dashboard hanya diakses same-origin (default, paling aman).
ALLOWED_ORIGINS=

# === AI Provider (opsional) ===
# Pilih salah satu: free / gemini / openai
AI_PROVIDER=free
# Isi API key jika menggunakan gemini atau openai
AI_API_KEY=

# === Tools ===
# API key untuk fitur remove background (WhatsApp/case/tools/removebg.js)
REMOVEBG_API_KEY=
